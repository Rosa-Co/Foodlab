' ============================================================
'  PACKAGE: DAO
' ============================================================
package "DAO" #E8F8F5 {

    interface ChefDAO {
        ~ void addChef(Chef)
        ~ Chef getChefById(int)
        ~ Chef getChefByEmail(String)
        ~ Chef getChefByUsername(String)
        ~ List<Chef> getallChefs()
        ~ void updateChef(Chef)
        ~ void deleteChef(Chef)
    }

    interface AllievoDAO {
        ~ void addAllievo(Allievo)
        ~ Allievo getAllievoById(int)
        ~ Allievo getAllievoByEmail(String)
        ~ Allievo getAllievoByUsername(String)
        ~ List<Allievo> getAllAllievos()
        ~ void updateAllievo(Allievo)
        ~ void deleteAllievo(Allievo)
    }

    interface CorsoDAO {
        ~ void addCorso(Corso)
        ~ List<Corso> getAllCorsi()
        ~ List<Corso> getCorsiByChef(int)
    }

    interface SessioneDAO {
        ~ void addSessione(Sessione)
        ~ List<Sessione> getSessioniByCorso(int)
        ~ void deleteSessione(int)
        ~ void updateSessione(Sessione)
    }

    interface RicettaDAO {
        ~ List<Ricetta> getAllRicette()
        ~ List<Ricetta> getRicetteByChef(int)
        ~ int addRicetta(Ricetta)
        ~ void addRicettaSessione(int,int)
    }

    interface NotificaDAO {
        ~ List<Notifica> getNotificheByChef(int)
        ~ int addNotifica(Notifica)
    }

    interface StatsDAO {
        ~ ChefStatsDTO getChefStats(int)
    }

    class ChefDAO_Postgree << (I,#117A65) >> {
        - {static} String UNIQUE_VIOLATION
        + void addChef(Chef)
        + List<Chef> getallChefs()
        + Chef getChefByUsername(String)
        + Chef getChefByEmail(String)
        + Chef getChefById(int)
        + void updateChef(Chef)
        + void deleteChef(Chef)
        - Chef mapRowToChef(ResultSet)
    }

    class AllievoDAO_Postgree << (I,#117A65) >> {
        - {static} String UNIQUE_VIOLATION
        + void addAllievo(Allievo)
        + List<Allievo> getAllAllievos()
        + Allievo getAllievoByEmail(String)
        + Allievo getAllievoById(int)
        + Allievo getAllievoByUsername(String)
        + void updateAllievo(Allievo)
        + void deleteAllievo(Allievo)
        - Allievo mapRowToAllievo(ResultSet)
    }

    class CorsoDAO_Postgree << (I,#117A65) >> {
        - {static} String UNIQUE_VIOLATION
        + void addCorso(Corso)
        + List<Corso> getAllCorsi()
        + List<Corso> getCorsiByChef(int)
        - Corso mapRowToCorso(ResultSet)
    }

    class SessioneDAO_Postgree << (I,#117A65) >> {
        + void addSessione(Sessione)
        + List<Sessione> getSessioniByCorso(int)
        + void deleteSessione(int)
        + void updateSessione(Sessione)
        - Sessione mapRowToSessione(ResultSet)
    }

    class RicettaDAO_Postgree << (I,#117A65) >> {
        - {static} String UNIQUE_VIOLATION
        + List<Ricetta> getAllRicette()
        + List<Ricetta> getRicetteByChef(int)
        + int addRicetta(Ricetta)
        + void addRicettaSessione(int,int)
        - Ricetta mapRowToRicetta(ResultSet)
