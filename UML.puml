' ============================================================
'  PACKAGE: MODEL
' ============================================================
package "Model" #EBF5FB {

    abstract class User << (A,#F4D03F) >> {
        - int id
        - String username
        - String email
        - String name
        - String surname
        - String password
        + int getId()
        + void setId(int)
        + String getUsername()
        + void setUsername(String)
        + String getEmail()
        + void setEmail(String)
        + String getName()
        + void setName(String)
        + String getSurname()
        + void setSurname(String)
        + String getPassword()
        + void setPassword(String)
        + {abstract} boolean isChef()
    }

    class Chef {
        + boolean isChef()
    }

    class Allievo {
        + boolean isChef()
    }

    class Corso {
        - int id
        - String titolo
        - String categoria
        - LocalDate dataInizio
        - String frequenza
        - int numeroSessioni
        + int getId()
        + void setId(int)
        + String getTitolo()
        + void setTitolo(String)
        + String getCategoria()
        + void setCategoria(String)
        + LocalDate getDataInizio()
        + void setDataInizio(LocalDate)
        + String getFrequenza()
        + void setFrequenza(String)
        + int getNumeroSessioni()
        + void setNumeroSessioni(int)
    }

    class Sessione {
        - int id
        - int numeroSessione
        - LocalDate dataSessione
        - String modalita
        - int durata
        - String descrizione
        + int getId()
        + void setId(int)
        + int getNumeroSessione()
        + void setNumeroSessione(int)
        + LocalDate getDataSessione()
        + void setDataSessione(LocalDate)
        + String getModalita()
        + void setModalita(String)
        + int getDurata()
        + void setDurata(int)
        + String getDescrizione()
        + void setDescrizione(String)
    }

    class Ricetta {
        - int id
        - String nome
        - String descrizione
        + int getId()
        + void setId(int)
        + String getNome()
        + void setNome(String)
        + String getDescrizione()
        + void setDescrizione(String)
        + String toString()
    }

    class Notifica {
        - int idAvviso
        - String titolo
        - String contenuto
        + int getIdAvviso()
        + void setIdAvviso(int)
        + String getTitolo()
        + void setTitolo(String)
        + String getContenuto()
        + void setContenuto(String)
    }

    User <|-- Chef
    User <|-- Allievo
    Sessione "1..*" --> "1" Corso : appartiene a
    Notifica "0..*" --> "1..*" Corso : riferita a
    Ricetta "0..*" --> "1" Chef : creata da
    Corso "0..*" --> "1" Chef : tenuto da
}

