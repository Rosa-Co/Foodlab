<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="progetto.app.view.NotificationsViewGUI"
      spacing="20" style="-fx-padding: 30;">

    <HBox alignment="CENTER_LEFT" spacing="20">
        <Label text="Notifiche Inviate" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="newNotificationButton" text="Nuova Notifica" styleClass="accent">
            <graphic>
                <FontIcon iconLiteral="fas-plus" iconSize="12"/>
            </graphic>
        </Button>
    </HBox>

    <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;" VBox.vgrow="ALWAYS">
        <VBox fx:id="notificationsContainer" spacing="15" style="-fx-background-color: transparent;">
            <!-- Notifiche caricate dinamicamente -->
        </VBox>
    </ScrollPane>
</VBox>
