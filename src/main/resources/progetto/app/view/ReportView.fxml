<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox xmlns="http://javafx.com/javafx/23.0.1"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="progetto.app.view.ReportViewGUI"
      spacing="20"
      style="-fx-padding: 30;">

    <Label text="Report Mensile" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: -color-fg-default;"/>

    <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;" VBox.vgrow="ALWAYS">
        <VBox spacing="30">
            <!-- Stats Cards -->
            <GridPane hgap="20" vgap="20">
                <columnConstraints>
                    <ColumnConstraints percentWidth="33"/>
                    <ColumnConstraints percentWidth="33"/>
                    <ColumnConstraints percentWidth="33"/>
                </columnConstraints>
                
                <!-- Total Courses -->
                <VBox style="-fx-background-color: white; -fx-padding: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 5, 0, 0, 2); -fx-background-radius: 10;" GridPane.columnIndex="0">
                     <Label text="Corsi Totali" style="-fx-font-size: 14px; -fx-text-fill: #7f8c8d;"/>
                     <Label fx:id="totalCoursesLabel" text="0" style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                </VBox>

                <!-- Online Sessions -->
                <VBox style="-fx-background-color: white; -fx-padding: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 5, 0, 0, 2); -fx-background-radius: 10;" GridPane.columnIndex="1">
                     <Label text="Sessioni Online" style="-fx-font-size: 14px; -fx-text-fill: #7f8c8d;"/>
                     <Label fx:id="onlineSessionsLabel" text="0" style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #3498db;"/>
                </VBox>

                <!-- Presence Sessions -->
                <VBox style="-fx-background-color: white; -fx-padding: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 5, 0, 0, 2); -fx-background-radius: 10;" GridPane.columnIndex="2">
                     <Label text="Sessioni Pratiche" style="-fx-font-size: 14px; -fx-text-fill: #7f8c8d;"/>
                     <Label fx:id="presenceSessionsLabel" text="0" style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #e67e22;"/>
                </VBox>
            </GridPane>

            <!-- Detailed Stats & Chart -->
            <HBox spacing="20" VBox.vgrow="ALWAYS" prefHeight="400">
                <!-- Recipe Stats -->
                <VBox style="-fx-background-color: white; -fx-padding: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 5, 0, 0, 2); -fx-background-radius: 10;" HBox.hgrow="ALWAYS" maxWidth="300">
                     <Label text="Statistiche Ricette (Pratiche)" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-padding: 0 0 20 0;"/>
                     
                     <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-padding: 10 0;">
                        <Label text="Media:" style="-fx-font-weight: bold;"/>
                        <Label fx:id="avgRecipesLabel" text="0.0" />
                     </HBox>
                     <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-padding: 10 0;">
                        <Label text="Massimo:" style="-fx-font-weight: bold;"/>
                        <Label fx:id="maxRecipesLabel" text="0" />
                     </HBox>
                     <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-padding: 10 0;">
                        <Label text="Minimo:" style="-fx-font-weight: bold;"/>
                        <Label fx:id="minRecipesLabel" text="0" />
                     </HBox>
                </VBox>

                <!-- Chart Container -->
                <BorderPane fx:id="chartContainer" HBox.hgrow="ALWAYS" style="-fx-background-color: white; -fx-padding: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 5, 0, 0, 2); -fx-background-radius: 10;"/>
            </HBox>

        </VBox>
    </ScrollPane>

</VBox>
