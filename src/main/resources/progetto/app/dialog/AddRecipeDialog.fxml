<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<DialogPane xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="progetto.app.view.AddRecipeDialogGUI"
            prefWidth="500">
    <content>
        <VBox spacing="15" style="-fx-padding: 20;">
            <Label text="Nuova Ricetta" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
            
            <GridPane vgap="10" hgap="10">
                <columnConstraints>
                    <ColumnConstraints minWidth="100" prefWidth="120" hgrow="NEVER"/>
                    <ColumnConstraints hgrow="ALWAYS"/>
                </columnConstraints>
                <Label text="Nome:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                <TextField fx:id="nameField" GridPane.columnIndex="1" GridPane.rowIndex="0" GridPane.hgrow="ALWAYS"/>
                
                <Label text="Descrizione:" GridPane.columnIndex="0" GridPane.rowIndex="1" alignment="TOP_LEFT"/>
                <TextArea fx:id="descriptionArea" GridPane.columnIndex="1" GridPane.rowIndex="1" prefRowCount="4" wrapText="true"/>
            </GridPane>
        </VBox>
    </content>
    <buttonTypes>
        <ButtonType fx:constant="FINISH"/>
        <ButtonType fx:constant="CANCEL"/>
    </buttonTypes>
</DialogPane>
