<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import org.kordamp.ikonli.javafx.*?>
<BorderPane xmlns="http://javafx.com/javafx/23.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="progetto.app.view.DashboardGUI"
            prefWidth="1200" prefHeight="700"
            style="-fx-background-color: -color-bg-default;">

    <!-- Top Bar: Header minimalista -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="16"
              style="-fx-background-color: -color-bg-default; -fx-padding: 12 20; -fx-border-color: -color-border-default; -fx-border-width: 0 0 1 0;">

            <!-- Logo -->
            <HBox alignment="CENTER_LEFT" spacing="10" HBox.hgrow="ALWAYS">
                <ImageView fx:id="logoImage" fitHeight="32" fitWidth="32" preserveRatio="true">
                    <HBox.margin>
                        <Insets left="4"/>
                    </HBox.margin>
                </ImageView>
                <Label text="UninaFoodLab" style="-fx-font-weight: bold; -fx-font-size: 15px;"/>
            </HBox>
            <!-- Info chef -->
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label fx:id="chefNameLabel" text="Chef Mario Rossi" style="-fx-font-size: 13px;"/>
                <MenuButton styleClass="flat">
                    <graphic>
                        <FontIcon iconLiteral="fas-user-circle" iconSize="18"/>
                    </graphic>
                    <items>
                        <MenuItem fx:id="logoutMenuItem" text="Logout">
                            <graphic><FontIcon iconLiteral="fas-sign-out-alt" iconSize="12"/></graphic>
                        </MenuItem>
                    </items>
                </MenuButton>
            </HBox>
        </HBox>
    </top>

    <!-- Left: Sidebar compatta -->
    <left>
        <VBox spacing="4" prefWidth="200"
              style="-fx-background-color: -color-bg-default; -fx-padding: 16 8; -fx-border-color: -color-border-default; -fx-border-width: 0 1 0 0;">

            <!-- Dashboard -->
            <Button fx:id="homeButton" text="Dashboard" maxWidth="Infinity" alignment="CENTER_LEFT"
                    styleClass="accent">
                <graphic>
                    <FontIcon iconLiteral="fas-home" iconSize="14"/>
                </graphic>
                <padding>
                    <Insets top="10" right="12" bottom="10" left="12"/>
                </padding>
            </Button>

            <!-- Corsi -->
            <Button fx:id="coursesButton" text="I Miei Corsi" maxWidth="Infinity" alignment="CENTER_LEFT"
                    styleClass="flat">
                <graphic>
                    <FontIcon iconLiteral="fas-book-open" iconSize="14"/>
                </graphic>
                <padding>
                    <Insets top="10" right="12" bottom="10" left="12"/>
                </padding>
            </Button>


            <!-- Ricette -->
            <Button fx:id="recipesButton" text="Ricette" maxWidth="Infinity" alignment="CENTER_LEFT" styleClass="flat">
                <graphic>
                    <FontIcon iconLiteral="fas-clipboard-list" iconSize="14"/>
                </graphic>
                <padding>
                    <Insets top="10" right="12" bottom="10" left="12"/>
                </padding>
            </Button>

            <!-- Notifiche -->
            <Button fx:id="notificationsButton" text="Notifiche" maxWidth="Infinity" alignment="CENTER_LEFT" styleClass="flat">
                <graphic>
                    <FontIcon iconLiteral="fas-bell" iconSize="14"/>
                </graphic>
                <padding>
                    <Insets top="10" right="12" bottom="10" left="12"/>
                </padding>
            </Button>

            <!-- Report -->
            <Button fx:id="reportButton" text="Report" maxWidth="Infinity" alignment="CENTER_LEFT" styleClass="flat">
                <graphic>
                    <FontIcon iconLiteral="fas-chart-pie" iconSize="14"/>
                </graphic>
                <padding>
                    <Insets top="10" right="12" bottom="10" left="12"/>
                </padding>
            </Button>

        </VBox>
    </left>

    <!-- Center: Area contenuto -->
    <center>
        <StackPane fx:id="contentContainer" style="-fx-background-color: -color-bg-subtle;"/>
    </center>
</BorderPane>