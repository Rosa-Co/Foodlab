<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<BorderPane xmlns="http://javafx.com/javafx/23.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
                fx:controller="progetto.app.view.DashboardGUI"
            styleClass="dashboard-container">

    <!-- Top Bar: Header con info chef -->
    <top>

        <HBox alignment="CENTER_LEFT"
              spacing="20"
              style="-fx-background-color: -color-bg-default; -fx-padding: 15 30; -fx-border-color: -color-border-default; -fx-border-width: 0 0 1 0;">

            <!-- Logo e titolo -->
            <HBox alignment="CENTER_LEFT" spacing="15" HBox.hgrow="ALWAYS">
                <FontIcon iconLiteral="fas-utensils" iconSize="28" style="-fx-icon-color: -color-accent-emphasis;"/>
                <VBox spacing="2">
                    <Label text="UninaFoodLab" styleClass="title-3"/>
                    <Label text="Chef Dashboard" style="-fx-opacity: 0.7; -fx-font-size: 12px;"/>
                </VBox>
            </HBox>

            <!-- Info chef e azioni -->
            <HBox alignment="CENTER_RIGHT" spacing="15">
                <!-- Notifiche -->
                <Button styleClass="flat">
                    <graphic>
                        <StackPane>
                            <FontIcon iconLiteral="fas-bell" iconSize="18"/>
                            <Label text="3"
                                   style="-fx-background-color: -color-danger-emphasis; -fx-text-fill: white; -fx-background-radius: 10px; -fx-padding: 2 5; -fx-font-size: 10px; -fx-font-weight: bold;"
                                   translateX="8" translateY="-8"/>
                        </StackPane>
                    </graphic>
                </Button>

                <!-- Info chef -->
                <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-padding: 5 15; -fx-background-color: -color-bg-subtle; -fx-background-radius: 20px;">
                    <FontIcon iconLiteral="fas-user-circle" iconSize="24" style="-fx-icon-color: -color-accent-emphasis;"/>
                    <VBox spacing="0">
                        <Label fx:id="chefNameLabel" text="Chef Mario Rossi" style="-fx-font-weight: bold;"/>
                        <Label text="Chef Professionista" style="-fx-opacity: 0.7; -fx-font-size: 11px;"/>
                    </VBox>
                </HBox>

                <!-- Menu azioni -->
                <MenuButton styleClass="flat">
                    <graphic>
                        <FontIcon iconLiteral="fas-ellipsis-v" iconSize="16"/>
                    </graphic>
                    <items>
                        <MenuItem text="Profilo">
                            <graphic>
                                <FontIcon iconLiteral="fas-user" iconSize="14"/>
                            </graphic>
                        </MenuItem>
                        <MenuItem text="Impostazioni">
                            <graphic>
                                <FontIcon iconLiteral="fas-cog" iconSize="14"/>
                            </graphic>
                        </MenuItem>
                        <SeparatorMenuItem/>
                        <MenuItem fx:id="logoutMenuItem" text="Logout">
                            <graphic>
                                <FontIcon iconLiteral="fas-sign-out-alt" iconSize="14"/>
                            </graphic>
                        </MenuItem>
                    </items>
                </MenuButton>
            </HBox>
        </HBox>
    </top>

    <!-- Left: Sidebar Navigation -->
    <left>

        <VBox spacing="5"
              prefWidth="250"
              style="-fx-background-color: -color-bg-default; -fx-padding: 20 10; -fx-border-color: -color-border-default; -fx-border-width: 0 1 0 0;">

            <Label text="NAVIGAZIONE" style="-fx-opacity: 0.5; -fx-font-size: 11px; -fx-font-weight: bold; -fx-padding: 10 15;">
                <padding>
                    <Insets top="10" left="15" bottom="5"/>
                </padding>
            </Label>

            <!-- Home -->
            <Button fx:id="homeButton" text="Dashboard" maxWidth="Infinity" alignment="CENTER_LEFT"
                    styleClass="accent">
                <graphic>
                    <FontIcon iconLiteral="fas-home" iconSize="16"/>
                </graphic>
                <padding>
                    <Insets top="12" right="15" bottom="12" left="15"/>
                </padding>
            </Button>

            <!-- Corsi -->
            <Button fx:id="coursesButton" text="I Miei Corsi" maxWidth="Infinity" alignment="CENTER_LEFT"
                    styleClass="flat">
                <graphic>
                    <FontIcon iconLiteral="fas-book-open" iconSize="16"/>
                </graphic>
                <padding>
                    <Insets top="12" right="15" bottom="12" left="15"/>
                </padding>
            </Button>

            <!-- Report -->
            <Button fx:id="reportButton" text="Report" maxWidth="Infinity" alignment="CENTER_LEFT"
                    styleClass="flat">
                <graphic>
                    <FontIcon iconLiteral="fas-chart-bar" iconSize="16"/>
                </graphic>
                <padding>
                    <Insets top="12" right="15" bottom="12" left="15"/>
                </padding>
            </Button>

            <Separator>
                <VBox.margin>
                    <Insets top="10" bottom="10"/>
                </VBox.margin>
            </Separator>

            <Label text="RISORSE" style="-fx-opacity: 0.5; -fx-font-size: 11px; -fx-font-weight: bold;">
                <padding>
                    <Insets top="10" left="15" bottom="5"/>
                </padding>
            </Label>

            <!-- Ricette -->
            <Button text="Ricette" maxWidth="Infinity" alignment="CENTER_LEFT" styleClass="flat">
                <graphic>
                    <FontIcon iconLiteral="fas-clipboard-list" iconSize="16"/>
                </graphic>
                <padding>
                    <Insets top="12" right="15" bottom="12" left="15"/>
                </padding>
            </Button>

            <!-- Ingredienti -->
            <Button text="Ingredienti" maxWidth="Infinity" alignment="CENTER_LEFT" styleClass="flat">
                <graphic>
                    <FontIcon iconLiteral="fas-carrot" iconSize="16"/>
                </graphic>
                <padding>
                    <Insets top="12" right="15" bottom="12" left="15"/>
                </padding>
            </Button>

            <!-- Spacer per spingere info in basso -->
            <Region VBox.vgrow="ALWAYS"/>

            <!-- Info versione -->
            <VBox spacing="5" style="-fx-padding: 15; -fx-background-color: -color-bg-subtle; -fx-background-radius: 8px;">
                <Label text="Versione 1.0.0" style="-fx-opacity: 0.5; -fx-font-size: 10px;"/>
                <Label text="© 2024 UninaFoodLab" style="-fx-opacity: 0.5; -fx-font-size: 10px;"/>
            </VBox>
        </VBox>
    </left>

    <!-- Center: Contenuto principale -->
    <center>
        <StackPane>
            <!-- Home View (default) -->
            <VBox fx:id="homeView" spacing="20" style="-fx-padding: 30;">
                <Label text="Dashboard" styleClass="title-2"/>

                <!-- Cards statistiche rapide -->
                <HBox spacing="20" alignment="CENTER_LEFT">
                    <fx:include source="StatsCard.fxml"/>
                </HBox>

                <!-- Sezione corsi recenti -->
                <VBox spacing="15" style="-fx-padding: 20; -fx-background-color: -color-bg-default; -fx-background-radius: 8px;">
                    <HBox alignment="CENTER_LEFT">
                        <Label text="I Miei Corsi" styleClass="title-3" HBox.hgrow="ALWAYS"/>
                        <Button text="Vedi Tutti" styleClass="flat"/>
                    </HBox>

                    <TableView fx:id="recentCoursesTable" styleClass="bordered">
                        <columns>
                            <TableColumn text="Categoria" prefWidth="150"/>
                            <TableColumn text="Data Inizio" prefWidth="120"/>
                            <TableColumn text="Sessioni" prefWidth="100"/>
                            <TableColumn text="Stato" prefWidth="120"/>
                            <TableColumn text="Azioni" prefWidth="150"/>
                        </columns>
                    </TableView>
                </VBox>
            </VBox>

            <!-- Corsi View -->
            <VBox fx:id="coursesView" visible="false" managed="false" spacing="20" style="-fx-padding: 30;">
                <HBox alignment="CENTER_LEFT" spacing="15">
                    <Label text="Gestione Corsi" styleClass="title-2" HBox.hgrow="ALWAYS"/>
                    <Button fx:id="addCourseButton" text="Nuovo Corso" styleClass="accent">
                        <graphic>
                            <FontIcon iconLiteral="fas-plus" iconSize="14"/>
                        </graphic>
                    </Button>
                </HBox>

                <!-- Filtri -->
                <HBox spacing="15" alignment="CENTER_LEFT" style="-fx-padding: 15; -fx-background-color: -color-bg-default; -fx-background-radius: 8px;">
                    <Label text="Filtri:"/>
                    <ComboBox fx:id="categoryFilter" promptText="Categoria" prefWidth="200"/>
                    <ComboBox fx:id="statusFilter" promptText="Stato" prefWidth="150"/>
                    <Button text="Applica" styleClass="accent"/>
                    <Button text="Reset" styleClass="flat"/>
                </HBox>

                <!-- Lista corsi con dettagli -->
                <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;">
                    <VBox fx:id="coursesContainer" spacing="15"/>
                </ScrollPane>
            </VBox>

            <!-- Report View -->
            <VBox fx:id="reportView" visible="false" managed="false" spacing="20" style="-fx-padding: 30;">
                <HBox alignment="CENTER_LEFT" spacing="15">
                    <Label text="Report Mensile" styleClass="title-2" HBox.hgrow="ALWAYS"/>
                    <ComboBox fx:id="monthSelector" promptText="Seleziona Mese" prefWidth="200"/>
                    <Button text="Genera Report" styleClass="accent"/>
                </HBox>

                <!-- Statistiche numeriche -->
                <GridPane hgap="20" vgap="20">
                    <VBox spacing="10" style="-fx-padding: 20; -fx-background-color: -color-bg-default; -fx-background-radius: 8px;" GridPane.columnIndex="0" GridPane.rowIndex="0">
                        <Label text="Corsi Totali" style="-fx-opacity: 0.7;"/>
                        <Label fx:id="totalCoursesLabel" text="0" styleClass="title-1"/>
                    </VBox>

                    <VBox spacing="10" style="-fx-padding: 20; -fx-background-color: -color-bg-default; -fx-background-radius: 8px;" GridPane.columnIndex="1" GridPane.rowIndex="0">
                        <Label text="Sessioni Online" style="-fx-opacity: 0.7;"/>
                        <Label fx:id="onlineSessionsLabel" text="0" styleClass="title-1"/>
                    </VBox>

                    <VBox spacing="10" style="-fx-padding: 20; -fx-background-color: -color-bg-default; -fx-background-radius: 8px;" GridPane.columnIndex="2" GridPane.rowIndex="0">
                        <Label text="Sessioni Pratiche" style="-fx-opacity: 0.7;"/>
                        <Label fx:id="practicalSessionsLabel" text="0" styleClass="title-1"/>
                    </VBox>
                </GridPane>

                <!-- Statistiche ricette -->
                <VBox spacing="15" style="-fx-padding: 20; -fx-background-color: -color-bg-default; -fx-background-radius: 8px;">
                    <Label text="Ricette nelle Sessioni Pratiche" styleClass="title-3"/>
                    <HBox spacing="30">
                        <VBox spacing="5">
                            <Label text="Media" style="-fx-opacity: 0.7;"/>
                            <Label fx:id="avgRecipesLabel" text="0.0" styleClass="title-2"/>
                        </VBox>
                        <VBox spacing="5">
                            <Label text="Minimo" style="-fx-opacity: 0.7;"/>
                            <Label fx:id="minRecipesLabel" text="0" styleClass="title-2"/>
                        </VBox>
                        <VBox spacing="5">
                            <Label text="Massimo" style="-fx-opacity: 0.7;"/>
                            <Label fx:id="maxRecipesLabel" text="0" styleClass="title-2"/>
                        </VBox>
                    </HBox>
                </VBox>

                <!-- Grafico JFreeChart -->
                <VBox spacing="15" style="-fx-padding: 20; -fx-background-color: -color-bg-default; -fx-background-radius: 8px;">
                    <Label text="Andamento Mensile" styleClass="title-3"/>
                    <StackPane fx:id="chartContainer" prefHeight="400" style="-fx-background-color: white; -fx-background-radius: 5px;"/>
                </VBox>
            </VBox>
        </StackPane>
    </center>
</BorderPane>