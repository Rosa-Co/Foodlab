<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<StackPane style="-fx-background-color: transparent;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="progetto.app.view.SplashGUI">
   <children>
      <VBox alignment="CENTER" spacing="30.0" style="-fx-background-color: linear-gradient(to bottom right, #ffffff, #f0f0f0); -fx-background-radius: 20; -fx-border-radius: 20; -fx-border-color: #e0e0e0; -fx-border-width: 1; -fx-border-radius: 20;">
         <children>
            <ImageView fx:id="logo" fitHeight="300.0" fitWidth="300.0" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@logo.png" />
               </image>
               <effect>
                  <DropShadow color="#00000020" offsetY="5.0" radius="15.0" spread="0.05" />
               </effect>
            </ImageView>
            <Label fx:id="typeWriterText" text="Caricamento..." textFill="#e67e22">
               <font>
                  <Font name="Segoe UI Bold" size="28.0" />
               </font>
            </Label>
            <ProgressBar prefWidth="200.0" progress="-1.0" style="-fx-accent: #e67e22;" />
         </children>
         <padding>
            <Insets bottom="50.0" left="50.0" right="50.0" top="50.0" />
         </padding>
         <effect>
            <DropShadow color="#00000040" height="50.0" radius="24.5" width="50.0" />
         </effect>
      </VBox>
   </children>
   <padding>
      <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
   </padding>
</StackPane>
